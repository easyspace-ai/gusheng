# ===== Core Server =====
# Optional. Default is 8787.
PORT=8787

# Required for production: HS256 secret for JWT access tokens (/api/auth).
# If empty, a development default is used (not safe to expose publicly).
# AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Optional. Root workspace path used by server data/services.
# If empty, server falls back to /data/workspace.
# OBSIDIAN_FS_ROOT=/absolute/path/to/workspace-root

# Optional. If you use Tushare source in other modules.
# TUSHARE_TOKEN=your_tushare_token

# ===== StockAPI (stockdb library) =====
# Cache mode: auto | readonly | disabled
STOCKAPI_CACHE_MODE=auto

# Data/cache root directory for stockapi.
# If empty, server uses its internal data dir.
# STOCKAPI_DATA_DIR=/absolute/path/to/data

# Cache TTLs (Go duration format).
# HISTORY: controls how long a Parquet kline file is treated as fresh before refetch/merge (see DataDir/stockapi-history/kline).
STOCKAPI_QUOTES_TTL=5s
STOCKAPI_HISTORY_TTL=24h
STOCKAPI_TIMELINE_TTL=5s

# Batch/concurrency tuning for full-market quote fetch
STOCKAPI_BATCH_SIZE=400
STOCKAPI_CONCURRENCY=5

# ===== stockapi-init / stockapi-cron (cmd prewarm) =====
# STOCKAPI_PREWARM_TIMEOUT=90m
# STOCKAPI_PREWARM_HISTORY_START=20200101
# STOCKAPI_PREWARM_HISTORY_END=
# STOCKAPI_PREWARM_CONCURRENCY=8
# Progress log every N symbols (empty or unset defaults to 100; set to 0 to disable periodic progress).
# STOCKAPI_PREWARM_LOG_EVERY=100
# Per-symbol history retries when error or empty bars (default 3). Backoff: attempt * STOCKAPI_PREWARM_RETRY_WAIT.
# STOCKAPI_PREWARM_RETRIES=3
# STOCKAPI_PREWARM_RETRY_WAIT=2s
# Daily k-line validation after each symbol (default on for stockapi-init). Set false to disable.
# STOCKAPI_PREWARM_VALIDATE=true
# Warn if fewer bars than this (default 120 in stockapi-init when unset).
# STOCKAPI_PREWARM_MIN_DAILY_BARS=120
